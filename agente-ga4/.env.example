# ===== Google Analytics (GA4) — auditoria, so leitura =====
# Pode reaproveitar o mesmo client_id/secret do projeto Cloud interno usado
# pro Ads e pro GTM (projeto agente-cmo-ads-interno). So precisa de um
# refresh_token novo com o scope analytics.readonly (gerar com
# generate_refresh_token_ga4.py). Ative "Google Analytics Admin API" e
# "Google Analytics Data API" nesse projeto Cloud antes de gerar o token.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# Propriedade correta do Integra Foods: conta "Integra Foods" (233412801),
# propriedade "IntegraFoods V2" (543849199), stream "SSR" ->
# https://integrafoods.ind.br. Confirmado em 22/07/2026 navegando
# analytics.google.com — coleta de dados ativa, measurement ID G-CC4D18ST42
# (bate com o que o GTM usa).
GA4_PROPERTY_ID=543849199
GA4_MEASUREMENT_ID=G-CC4D18ST42
