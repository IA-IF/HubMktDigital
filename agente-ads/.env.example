# ===== Google Ads API =====
# Developer token, client_id/secret e refresh_token sao os MESMOS do
# ..\..\GADS\agente-cmo\.env (mesma MCC 890-192-5637 "IF Apoio", mesmo
# projeto Cloud interno) — so copiar de la. Se o refresh_token existente nao
# tiver acesso a conta nova, gere um novo com generate_refresh_token.py.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Conta "Integra Foods V2" (criada 22/07/2026), sem hifens
GOOGLE_ADS_CUSTOMER_ID=3323166484
# MCC "IF Apoio", sem hifens
GOOGLE_ADS_LOGIN_CUSTOMER_ID=8901925637

# ===== LLM do analyst.py =====
# 'anthropic' ou 'openai' — qual API o analyst.py usa para gerar as
# recomendacoes. Default openai porque e o credito disponivel agora
# (jul/2026); troque para 'anthropic' para comparar performance quando
# houver credito nos dois ao mesmo tempo.
LLM_PROVIDER=openai

# ===== Anthropic =====
ANTHROPIC_API_KEY=
# Modelo usado pelo analista (o guia especifica claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ===== Guardrails (validados em codigo pelo executor.py) =====
TETO_GASTO_DIARIO=500
LIMITE_APROVACAO_DIARIO=100
MAX_MUDANCA_ORCAMENTO_PCT=20

# ===== Relatorios (opcionais - deixe vazio para so gravar em logs/) =====
# Webhook do Slack (Incoming Webhook) ou similar
SLACK_WEBHOOK_URL=
# Telegram: envio unidirecional do relatorio diario (nao e o bot conversacional
# — esse mora em ../agente-julio). Crie um bot com @BotFather (token) e pegue
# o chat_id conversando com @userinfobot (chat pessoal) ou add o bot a um grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
