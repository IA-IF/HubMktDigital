# ===== Google Tag Manager (auditoria, so leitura) =====
# Pode reaproveitar o mesmo client_id/secret do projeto Cloud interno criado
# para o Ads (projeto agente-cmo-ads-interno — ver
# C:\INTEGRAFOODS\teste\GADS\agente-cmo\docs\setup-do-zero-checklist.md), so
# precisa de um refresh_token novo com o scope tagmanager.readonly (gerar com
# generate_refresh_token_gtm.py). Ative "Tag Manager API" nesse projeto Cloud
# antes de gerar o token.
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=

# accounts/<GTM_ACCOUNT_ID>/containers/<GTM_CONTAINER_ID> — achados no export
# do container em C:\INTEGRAFOODS\www\web2\IA\GTM-PJWJJHXR_workspace7.json
GTM_ACCOUNT_ID=6363669174
GTM_CONTAINER_ID=257024578

# Measurement ID do GA4 esperado nessa tag (Google tag) do container, para
# conferir se bate com o que esta configurado de fato.
GA4_MEASUREMENT_ID=G-CC4D18ST42
