# ===== Google Search Console — auditoria, so leitura =====
# Pode reaproveitar o mesmo client_id/secret do projeto Cloud interno usado
# pro Ads/GTM/GA4 (projeto agente-cmo-ads-interno). So precisa de um
# refresh_token novo com o scope webmasters.readonly (gerar com
# generate_refresh_token_sc.py). Ative "Google Search Console API" nesse
# projeto Cloud antes de gerar o token.
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REFRESH_TOKEN=

# Propriedade correta do Integra Foods: URL-prefix property, ja verificada
# (confirmado 22/07/2026 navegando search.google.com — eduardo.rezende@
# integrafoods.ind.br e Proprietario). NAO confundir com a propriedade do
# dominio antigo/staging https://if-ssr.conge.digital/ (mantida a parte,
# nao mexer).
SC_SITE_URL=https://integrafoods.ind.br/
