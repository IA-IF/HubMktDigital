# ===== LLM =====
# 'anthropic' ou 'openai'. Default openai porque e o credito disponivel
# agora (jul/2026); troque para 'anthropic' pra comparar performance.
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ===== Telegram =====
# Crie um bot com @BotFather (token) e pegue o chat_id conversando com
# @userinfobot (chat pessoal) ou adicionando o bot a um grupo.
TELEGRAM_BOT_TOKEN=
# Chat_ids autorizados a conversar com o Julio (separados por virgula).
# So quem estiver aqui pode pedir a criacao de campanhas novas.
TELEGRAM_AUTHORIZED_CHAT_IDS=
