# Compartilhado entre os 3 sites e os 4 modulos (agente-ads, agente-ga4,
# agente-gtm, agente-search-console) + agente-julio. Valores unicos por
# site ficam em SITES/<site>/.env — copie SITES/_template/.env.example.
#
# Copie este arquivo para .env na raiz do projeto e preencha.

# --- Google Ads (mesma MCC/dev token pros 3 sites) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- GTM (mesmo client Google, scope tagmanager.readonly) ---
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=

# --- GA4 (mesmo client Google, scope analytics.readonly) ---
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# --- Search Console (mesmo client Google, scope webmasters.readonly) ---
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REFRESH_TOKEN=

# --- LLM (usado por agente-ads/analyst.py e agente-julio) ---
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Telegram (bot unico do agente-julio, reaproveitado no push de
# relatorio diario do agente-ads) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_CHAT_IDS=

# --- Guardrails default do agente-ads (sobrescreva em SITES/<site>/.env
# se algum site precisar de um teto diferente) ---
TETO_GASTO_DIARIO=500
LIMITE_APROVACAO_DIARIO=100
MAX_MUDANCA_ORCAMENTO_PCT=20

# --- Report (agente-ads), opcional ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
