# O agente-gtm nao tem mais .env.<site> proprio. GTM_CLIENT_ID/SECRET/
# REFRESH_TOKEN (OAuth compartilhado) vem de ../.env — copie
# ../.env.example. GTM_ACCOUNT_ID/GTM_CONTAINER_ID/GA4_MEASUREMENT_ID/
# SITE_URL (unicos do site) vem de ../SITES/<site>/.env — copie
# ../SITES/_template/.env.example para ../SITES/<slug>/.env ao integrar um
# site novo (ver .claude/skills/onboard-site).
