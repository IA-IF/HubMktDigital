# Template para onboarding de site novo (ver .claude/skills/onboard-site).
# Copie esta pasta para SITES/<slug>/ e preencha os valores do site novo.
# O resto (OAuth client, LLM, Telegram) vem do .env compartilhado na raiz
# do projeto — nao duplique aqui.

# --- Google Ads ---
GOOGLE_ADS_CUSTOMER_ID=

# --- GA4 ---
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=

# --- GTM ---
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=

# --- Search Console / URL de producao ---
SITE_URL=
SC_SITE_URL=
